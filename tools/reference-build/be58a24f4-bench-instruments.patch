+// ---- backported bench instruments (not upstream) -------------------------
+static volatile uint8_t refPendingInput = 0;      // 1..6, 0 = nothing queued
+static uint32_t refLogUntil = 0, refLogNext = 0, refLogStart = 0;
+static uint16_t refLogEveryMs = 25;
+
+static void refEmitSample(uint32_t sinceMs)
+{
+    uint8_t bits = (uint8_t)(GBS::STATUS_IF_HT_OK::read()
+                   | (GBS::STATUS_IF_VT_OK::read() << 1)
+                   | (GBS::STATUS_IF_HT_BAD::read() << 2)
+                   | (GBS::STATUS_IF_VT_BAD::read() << 3)
+                   | (GBS::STATUS_IF_NO_SYNC::read() << 4));
+    char line[96];
+    snprintf(line, sizeof(line), "smp,%lu,%u,%u,%u,%u,%u,%u,%u,%u,%u",
+             (unsigned long)sinceMs,
+             (unsigned)GBS::PLLAD_MD::read(),
+             (unsigned)GBS::STATUS_MISC_PLLAD_LOCK::read(),
+             (unsigned)GBS::STATUS_SYNC_PROC_VTOTAL::read(),
+             (unsigned)GBS::STATUS_SYNC_PROC_HTOTAL::read(),
+             (unsigned)GBS::HPERIOD_IF::read(),
+             (unsigned)GBS::VPERIOD_IF::read(),
+             (unsigned)GBS::STATUS_SYNC_PROC_HSACT::read(),
+             (unsigned)bits,
+             (unsigned)GBS::STATUS_0F::read());
+    SerialM.println(line);
+}
+
+static void refServiceInstruments()
+{
+    if (refPendingInput != 0) {
+        uint8_t want = refPendingInput;
+        refPendingInput = 0;
+        switch (want) {
+            case 1: InputRGBs_mode(0); break;
+            case 2: InputRGsB_mode(0); break;
+            case 3: InputVGA_mode(0); break;
+            case 4: InputYUV(); break;
+            case 5: InputSV_mode(0); break;
+            case 6: InputAV_mode(0); break;
+            default: break;
+        }
+    }
+
+    if (refLogUntil != 0) {
+        uint32_t now = millis();
+        if ((int32_t)(now - refLogUntil) >= 0) {
+            refLogUntil = 0;
+            SerialM.println("smp,done");
+        } else if ((int32_t)(now - refLogNext) >= 0) {
+            refLogNext = now + refLogEveryMs;
+            refEmitSample(now - refLogStart);
+        }
+    }
+}

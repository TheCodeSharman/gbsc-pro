# direnv cached dev shell
.direnv/

# Build caches and outputs — large, regenerable, never commit.

# arduino-cli isolated data dir, package downloads, and per-user dir
build/data/
build/downloads/
build/user/
# arduino-cli build output (.bin / .elf / .map / objects)
build/output/
# compiled host unit-test binaries
test/output/

# Python bytecode (test_loopback.py imports the flasher module)
__pycache__/

# Editor and agent settings, which are one person's machine rather than the
# project: .claude/settings.json holds absolute paths under /home/msharman.
.claude/

# web UI toolchain: `npm ci` in GBSC-Pro-Source code/gbs-control/public installs
# the tsc the repo pins (4.1.3), which the build needs and nixpkgs cannot supply
node_modules/
